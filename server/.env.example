# SERVER PORT
PORT=4000

# POSTGRESQL DATABASE URI
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"

# APPLICATION ENVIRONMENT (development | staging | production)
APP_ENV=development

# CORS ALLOWED ORIGIN
CORS_ORIGIN="http://localhost:3000"

# JWT AUTHENTICATION SECRETS & EXPIRATIONS
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_EXPIRES_IN=7d

# MASTER ADMIN INITIALIZATION CREDENTIALS
MASTER_ADMIN_USERNAME=natishget
MASTER_ADMIN_PASSWORD=your_master_admin_password_here
BCRYPT_SALT_ROUNDS=10

# PAYMENT PROVIDER INTEGRATION KEYS
TELEBIRR_API_KEY=your_telebirr_api_key_here
CBE_BIRR_API_KEY=your_cbe_birr_api_key_here
