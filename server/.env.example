# SERVER PORT
PORT=4000

# POSTGRESQL DATABASE URI (Supabase Pooler & Direct Connection)
DATABASE_URL="postgresql://postgres.gwmxldmuaniikhqnsrxy:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.gwmxldmuaniikhqnsrxy:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# APPLICATION ENVIRONMENT (development | staging | production)
APP_ENV=development

# CORS ALLOWED ORIGIN
CORS_ORIGIN="http://localhost:3000"

# JWT AUTHENTICATION SECRETS & EXPIRATIONS
JWT_SECRET=your_jwt_secret_key_here
